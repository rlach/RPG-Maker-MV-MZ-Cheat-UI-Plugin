{
    "name": "rpg-maker-mv-mz-cheat-ui-plugin",
    "private": true,
    "version": "1.26.3",
    "scripts": {
        "deploy": "python ./deploy/main.py",
        "format": "prettier --write \"./cheat-engine/www/**/*.{js,vue,css,html,json}\" \"./types/**/*.d.ts\" \"./.vscode/*.{json}\" \"./*.json\"",
        "format:check": "prettier --check \"./cheat-engine/www/**/*.{js,vue,css,html,json}\" \"./types/**/*.d.ts\" \"./.vscode/*.{json}\" \"./*.json\"",
        "lint": "eslint ./cheat-engine/www --ext .js,.vue",
        "lint:fix": "eslint ./cheat-engine/www --ext .js,.vue --fix",
        "check:duplicates": "node ./scripts/check-duplicates.mjs",
        "check:duplicates:strict": "node ./scripts/check-duplicates.mjs --strict",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "@eslint/js": "^9.24.0",
        "eslint": "^9.24.0",
        "eslint-plugin-vue": "^9.24.0",
        "globals": "^16.0.0",
        "jscpd": "^4.0.5",
        "prettier": "^3.5.3",
        "vitest": "^4.1.5",
        "vue-eslint-parser": "^10.0.0"
    }
}
